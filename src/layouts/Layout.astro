---
import '../styles/global.css';
import type { Lang } from '../i18n/index';
import QuickContact from '../components/QuickContact.astro';

interface Props {
  title: string;
  description?: string;
  lang: Lang;
}

const { title, description = 'Casa vacanze a Mondello, la spiaggia di Palermo. Appartamento luminoso a pochi passi dal mare.', lang } = Astro.props;

const canonicalIt = 'https://mondelloholiday.it/';
const canonicalEn = 'https://mondelloholiday.it/en/';

---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://mondelloholiday.it/images/pellegrino_003.jpg" />
    <link rel="alternate" hreflang="it" href={canonicalIt} />
    <link rel="alternate" hreflang="en" href={canonicalEn} />
    <link rel="alternate" hreflang="x-default" href={canonicalIt} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <!-- GLightbox -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/glightbox@3/dist/css/glightbox.min.css" />
  </head>
  <body class="font-sans text-slate-800 bg-white antialiased">
    <slot />
    <script is:inline src="https://cdn.jsdelivr.net/npm/glightbox@3/dist/js/glightbox.min.js"></script>

    <QuickContact lang={lang} />
  </body>
</html>
