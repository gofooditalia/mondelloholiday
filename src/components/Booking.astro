---
import { t } from '../i18n/index';
import type { Lang } from '../i18n/index';
import ContactForm from './ContactForm.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const tr = t(lang);

// Annuncio Holidu (canale preferito: commissioni più basse). Contiene entrambe le unità.
const HOLIDU_URL = 'https://www.holidu.com/d/69629882';

const houseInfo = {
  it: [
    ['Check-in', 'dalle 15:00 alle 24:00'],
    ['Check-out', 'entro le 10:00'],
    ['Incluso', 'biancheria, asciugamani, asciugacapelli, set di cortesia, ferro da stiro'],
    ['Regole', 'adatto alle famiglie · niente animali · vietato fumare'],
    ['Parcheggio', 'in strada'],
  ],
  en: [
    ['Check-in', 'from 3:00 PM to midnight'],
    ['Check-out', 'by 10:00 AM'],
    ['Included', 'bed linen, towels, hairdryer, toiletries, iron'],
    ['Rules', 'family friendly · no pets · no smoking'],
    ['Parking', 'on the street'],
  ],
};

const rooms = [
  {
    name: 'Mini-Casa Clio',
    features: {
      it: ['1–2 ospiti · letto matrimoniale 120×190', 'Bagno privato ad uso esclusivo con doccia', 'Angolo cottura attrezzato e lavatrice privata', 'Aria condizionata, riscaldamento, Wi-Fi veloce e TV', 'Cabina armadio · vista sul cortile', 'Soggiorno, salone e balcone retro in comune'],
      en: ['1–2 guests · double bed 120×190', 'Private bathroom for exclusive use with shower', 'Equipped kitchenette and private washing machine', 'Air conditioning, heating, fast Wi-Fi and TV', 'Walk-in closet · yard view', 'Shared living room, lounge and back balcony'],
    },
    url: HOLIDU_URL,
  },
  {
    name: 'Pellegrino',
    features: {
      it: ['Fino a 4 ospiti · bagno ad uso esclusivo con vasca', 'Camera matrimoniale 25 m² con balcone privato e vista sui monti', 'Camera con due letti singoli 18 m²', 'Aria condizionata nella matrimoniale, ventilatore a soffitto nella doppia, riscaldamento', 'Frigorifero, macchina del caffè, Wi-Fi veloce e TV', 'Soggiorno, salone e balcone retro in comune'],
      en: ['Up to 4 guests · private bathroom for exclusive use with bathtub', '25 m² double bedroom with private balcony and mountain view', '18 m² twin room with two single beds', 'Air conditioning in the double, ceiling fan in the twin room, heating', 'Fridge, coffee machine, fast Wi-Fi and TV', 'Shared living room, lounge and back balcony'],
    },
    url: HOLIDU_URL,
  },
];
---

<section id="prenota" class="py-20 lg:py-28 bg-sky-900 text-white">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Section header -->
    <div class="text-center mb-14">
      <h2 class="font-display text-4xl lg:text-5xl font-bold mb-4">
        {tr.booking.title}
      </h2>
      <p class="text-lg text-sky-200 max-w-2xl mx-auto">
        {tr.booking.subtitle}
      </p>
      <div class="mt-5 w-14 h-0.5 bg-amber-400 mx-auto"></div>
    </div>

    <!-- Room cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-12 max-w-3xl mx-auto">
      {rooms.map((room) => {
        const available = !!room.url;
        const features = lang === 'it' ? room.features.it : room.features.en;
        return (
          <div class={[
            'relative rounded-2xl p-7 flex flex-col',
            available
              ? 'bg-white text-slate-800'
              : 'bg-sky-800/50 text-sky-200 border border-sky-700',
          ].join(' ')}>

            {!available && (
              <span class="absolute top-4 right-4 text-xs font-semibold tracking-widest uppercase bg-sky-700 text-sky-200 px-3 py-1 rounded-full">
                {tr.booking.comingSoon}
              </span>
            )}

            <!-- Room icon -->
            <div class={['w-12 h-12 rounded-xl flex items-center justify-center mb-5', available ? 'bg-sky-50' : 'bg-sky-700/50'].join(' ')}>
              <svg class={['w-6 h-6', available ? 'text-sky-600' : 'text-sky-400'].join(' ')} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
              </svg>
            </div>

            <h3 class={['font-display font-bold text-xl mb-4', available ? 'text-slate-800' : 'text-sky-200'].join(' ')}>
              {room.name}
            </h3>

            <ul class="space-y-2 mb-7 flex-1">
              {features.map((f) => (
                <li class={['flex items-center gap-2 text-sm', available ? 'text-slate-600' : 'text-sky-300'].join(' ')}>
                  <svg class={['w-4 h-4 flex-shrink-0', available ? 'text-amber-400' : 'text-sky-500'].join(' ')} fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                  </svg>
                  {f}
                </li>
              ))}
            </ul>

            {available ? (
              <a
                href={room.url}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-center gap-2 bg-amber-400 hover:bg-amber-500 text-slate-900 font-semibold text-sm px-5 py-3 rounded-full transition-all duration-200 hover:scale-105 shadow-md"
              >
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm.75 17.5c-.414 0-.75-.336-.75-.75v-5h-1.5c-.414 0-.75-.336-.75-.75s.336-.75.75-.75H12V8.75c0-.414.336-.75.75-.75s.75.336.75.75V10.25h1.5c.414 0 .75.336.75.75s-.336.75-.75.75h-1.5v5c0 .414-.336.75-.75.75zm0-10.5c-.552 0-1-.448-1-1s.448-1 1-1 1 .448 1 1-.448 1-1 1z"/>
                </svg>
                {tr.booking.bookOnline}
              </a>
            ) : (
              <div class="flex items-center justify-center gap-2 bg-sky-700/50 text-sky-400 text-sm px-5 py-3 rounded-full cursor-not-allowed">
                {tr.booking.comingSoon}
              </div>
            )}
          </div>
        );
      })}
    </div>

    <!-- House info -->
    <div class="max-w-3xl mx-auto mb-12 rounded-2xl border border-sky-800 bg-sky-800/30 px-6 py-5">
      <h3 class="text-xs font-semibold tracking-widest uppercase text-amber-300 mb-3">
        {lang === 'it' ? 'Informazioni utili' : 'Good to know'}
      </h3>
      <dl class="grid grid-cols-1 sm:grid-cols-[auto_1fr] gap-x-6 gap-y-2 text-sm">
        {houseInfo[lang].map(([k, v]) => (
          <>
            <dt class="font-semibold text-white">{k}</dt>
            <dd class="text-sky-200 mb-1 sm:mb-0">{v}</dd>
          </>
        ))}
      </dl>
    </div>

    <!-- Contact form -->
    <div class="border-t border-sky-800 pt-12">
      <div class="text-center mb-8">
        <h3 class="font-display font-bold text-2xl text-white mb-2">
          {lang === 'it' ? 'Scrivi una richiesta' : 'Send a request'}
        </h3>
        <p class="text-sky-300 text-sm">
          {lang === 'it'
            ? 'Indica le date e riceverai una conferma con il prezzo scontato.'
            : 'Include your dates and we\'ll reply with the discounted rate.'}
        </p>
      </div>
      <ContactForm lang={lang} />
    </div>
  </div>
</section>
