---
import { t } from '../i18n/index';
import type { Lang } from '../i18n/index';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const f = t(lang).form;

const today = new Date().toISOString().split('T')[0];
const rooms = ['Mini-Casa Clio (1–2 ospiti)', 'Pellegrino (fino a 4 ospiti)'];
---

<div class="bg-white rounded-2xl shadow-xl p-8 lg:p-10">

  <!-- Messaggio di conferma: mostrato dopo l'invio riuscito -->
  <div data-cf-success hidden class="text-center py-6">
    <div class="w-16 h-16 rounded-full bg-emerald-100 flex items-center justify-center mx-auto mb-5">
      <svg class="w-8 h-8 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
      </svg>
    </div>
    <h3 class="font-display font-bold text-xl text-slate-800 mb-2">{f.successTitle}</h3>
    <p class="text-slate-500 text-sm">{f.successMsg}</p>
  </div>

  <!-- Errore di invio -->
  <div data-cf-error hidden class="mb-5 text-sm text-rose-600 bg-rose-50 border border-rose-100 rounded-lg px-4 py-3">{f.errorMsg}</div>

  <form id="contact-form" data-lang={lang} data-submitting={f.submitting}>
    <div class="hidden" aria-hidden="true"><input name="website" tabindex="-1" autocomplete="off" /></div>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-5 gap-y-4">

      <!-- Name -->
      <div class="flex flex-col gap-1">
        <label class="field-label" for="cf-name">{f.name} <span class="text-rose-400">*</span></label>
        <input
          id="cf-name" name="name" type="text" required
          placeholder={f.namePlaceholder}
          class="field-input"
        />
      </div>

      <!-- Email -->
      <div class="flex flex-col gap-1">
        <label class="field-label" for="cf-email">{f.email} <span class="text-rose-400">*</span></label>
        <input
          id="cf-email" name="email" type="email" required
          placeholder={f.emailPlaceholder}
          class="field-input"
        />
      </div>

      <!-- Room (full width) -->
      <div class="flex flex-col gap-1 sm:col-span-2">
        <label class="field-label" for="cf-room">{f.room}</label>
        <select id="cf-room" name="room" class="field-input">
          <option value="">{f.roomDefault}</option>
          {rooms.map((r) => <option value={r}>{r}</option>)}
        </select>
      </div>

      <!-- Check-in -->
      <div class="flex flex-col gap-1">
        <label class="field-label" for="cf-checkin">{f.checkin} <span class="text-rose-400">*</span></label>
        <input
          id="cf-checkin" name="checkin" type="date" required
          min={today}
          class="field-input"
        />
      </div>

      <!-- Check-out -->
      <div class="flex flex-col gap-1">
        <label class="field-label" for="cf-checkout">{f.checkout} <span class="text-rose-400">*</span></label>
        <input
          id="cf-checkout" name="checkout" type="date" required
          min={today}
          class="field-input"
        />
      </div>

      <!-- Message (full width) -->
      <div class="flex flex-col gap-1 sm:col-span-2">
        <label class="field-label" for="cf-message">{f.message}</label>
        <textarea
          id="cf-message" name="message" rows="3"
          placeholder={f.messagePlaceholder}
          class="field-input resize-none"
        ></textarea>
      </div>

    </div>

    <button
      type="submit"
      class="mt-6 w-full flex items-center justify-center gap-2 bg-amber-400 hover:bg-amber-500 text-slate-900 font-semibold text-base px-8 py-3.5 rounded-full transition-all duration-200 hover:scale-[1.02] shadow-md shadow-amber-400/30 disabled:opacity-60 disabled:cursor-not-allowed disabled:scale-100"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
      </svg>
      {f.submit}
    </button>
  </form>
</div>

<style>
  .field-label {
    font-size: 0.8125rem;
    font-weight: 500;
    color: #475569;
  }
  .field-input {
    width: 100%;
    border: 1px solid #e2e8f0;
    border-radius: 0.625rem;
    padding: 0.625rem 0.875rem;
    font-size: 0.9375rem;
    color: #1e293b;
    background: #f8fafc;
    outline: none;
    transition: border-color 0.15s, box-shadow 0.15s;
    font-family: inherit;
  }
  .field-input:focus {
    border-color: #0ea5e9;
    box-shadow: 0 0 0 3px rgba(14, 165, 233, 0.12);
    background: #fff;
  }
  .field-input[aria-invalid="true"] {
    border-color: #f43f5e;
    box-shadow: 0 0 0 3px rgba(244, 63, 94, 0.1);
  }
  .field-input::placeholder { color: #94a3b8; }
  select.field-input { appearance: auto; }
</style>

<script is:inline>
  // Invio della richiesta a /api/contact (Resend → info@gofood.it)
  (function () {
    var form = document.getElementById('contact-form');
    if (!form) return;
    var box = form.parentElement;
    var success = box.querySelector('[data-cf-success]');
    var error = box.querySelector('[data-cf-error]');
    var button = form.querySelector('button[type="submit"]');
    var label = button.innerHTML;

    var cin = document.getElementById('cf-checkin');
    var cout = document.getElementById('cf-checkout');
    if (cin && cout) {
      cin.addEventListener('change', function () {
        cout.min = this.value;
        if (cout.value && cout.value <= this.value) cout.value = '';
      });
    }

    form.addEventListener('submit', function (e) {
      e.preventDefault();
      if (!form.reportValidity()) return;
      error.hidden = true;
      button.disabled = true;
      button.textContent = form.dataset.submitting;
      var data = Object.fromEntries(new FormData(form).entries());
      data.lang = form.dataset.lang;
      data.source = 'form';
      fetch('/api/contact', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) })
        .then(function (r) {
          if (!r.ok) throw new Error();
          form.hidden = true;
          success.hidden = false;
        })
        .catch(function () { error.hidden = false; })
        .finally(function () { button.disabled = false; button.innerHTML = label; });
    });
  })();
</script>
